{
  "name": "dive-intelligence",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "vite --port 4200 --strictPort",
    "build": "tsc -b && vite build",
    "watch": "vite build --watch --mode development",
    "test": "vitest",
    "ci-test": "vitest run --coverage --reporter=default --reporter=junit --outputFile=test-results/unit-tests/unit-tests.xml",
    "lint": "eslint .",
    "deploy": "swa deploy ./dist/dive-intelligence/browser",
    "playwright": "npx playwright test",
    "all": "npm run lint && npm run build && npm run ci-test && npx playwright test"
  },
  "private": true,
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@microsoft/applicationinsights-web": "^3.3.10",
    "@mui/material": "^7.0.0",
    "plotly.js-basic-dist-min": "^3.3.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@azure/static-web-apps-cli": "^2.0.7",
    "@playwright/test": "^1.57.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^25.0.3",
    "@types/plotly.js-basic-dist-min": "^2.12.4",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^3.2.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "jsdom": "^26.0.0",
    "monocart-reporter": "^2.9.23",
    "prettier": "^3.7.4",
    "sass": "^1.83.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.51.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
